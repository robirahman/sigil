{
  "rules": {
    "users": {
      "$uid": {
        ".read": true,
        ".write": "auth !== null && newData.exists() && (auth.uid === $uid || $uid.matches(/^__ai_[a-z0-9_]+__$/))",
        "displayName": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
        },
        "elo": {
          ".write": "auth !== null",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000 && (data.exists() ? (newData.val() - data.val() <= 32 && data.val() - newData.val() <= 32) : (newData.val() >= 900 && newData.val() <= 1300))"
        },
        "gamesPlayed": {
          ".write": "auth !== null",
          ".validate": "newData.isNumber() && (data.exists() ? (newData.val() >= data.val() && newData.val() <= data.val() + 1) : (newData.val() === 0 || newData.val() === 1))"
        },
        "wins": {
          ".write": "auth !== null",
          ".validate": "newData.isNumber() && (data.exists() ? (newData.val() >= data.val() && newData.val() <= data.val() + 1) : (newData.val() === 0 || newData.val() === 1))"
        },
        "losses": {
          ".write": "auth !== null",
          ".validate": "newData.isNumber() && (data.exists() ? (newData.val() >= data.val() && newData.val() <= data.val() + 1) : (newData.val() === 0 || newData.val() === 1))"
        },
        "created": {
          ".validate": "newData.isNumber()"
        },
        "annotationMode": {
          ".validate": "newData.isBoolean()"
        },
        "showAiEval": {
          ".validate": "newData.isBoolean()"
        },
        "showAiThinkReport": {
          ".validate": "newData.isBoolean()"
        },
        "showMapControl": {
          ".validate": "newData.isBoolean()"
        },
        "enablePondering": {
          ".validate": "newData.isBoolean()"
        },
        "isAI": {
          ".validate": "newData.isBoolean() && $uid.matches(/^__ai_[a-z0-9_]+__$/)"
        },
        "isDeveloper": {
          ".validate": "newData.isBoolean() && newData.val() === false"
        }
      }
    },
    "leaderboard": {
      ".read": true,
      ".indexOn": ["elo"],
      "$uid": {
        ".write": "auth !== null && newData.exists() && (auth.uid === $uid || $uid.matches(/^__ai_[a-z0-9_]+__$/))",
        "displayName": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
        },
        "elo": {
          ".write": "auth !== null",
          ".validate": "newData.isNumber() && (data.exists() ? (newData.val() - data.val() <= 32 && data.val() - newData.val() <= 32) : (root.child('users/' + $uid + '/elo').exists() ? (newData.val() - root.child('users/' + $uid + '/elo').val() <= 32 && root.child('users/' + $uid + '/elo').val() - newData.val() <= 32) : (newData.val() >= 900 && newData.val() <= 1300)))"
        },
        "gamesPlayed": {
          ".write": "auth !== null",
          ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() >= data.val())"
        },
        "isAI": {
          ".validate": "newData.isBoolean() && $uid.matches(/^__ai_[a-z0-9_]+__$/)"
        },
        "isDeveloper": {
          ".validate": "newData.isBoolean() && newData.val() === false"
        }
      }
    },
    "rooms": {
      "$roomId": {
        ".read": true,
        ".write": true
      }
    },
    "completed_games": {
      ".read": false,
      "$gameId": {
        ".write": "auth !== null",
        ".validate": "newData.hasChildren(['winner', 'timestamp'])",
        "annotations": {
          "$turnNumber": {
            ".validate": "newData.val() === 'good' || newData.val() === 'bad' || !newData.exists()"
          }
        },
        "eval_annotations": {
          "$turnNumber": {
            ".validate": "newData.val() === 'red' || newData.val() === 'blue' || newData.val() === 'even' || !newData.exists()"
          }
        }
      }
    },
    "user_games": {
      "$uid": {
        ".read": true,
        ".indexOn": ["timestamp"],
        "$gameId": {
          ".write": "auth !== null && (auth.uid === $uid || newData.child('opponentUid').val() === auth.uid)"
        }
      }
    },
    "user_active_games": {
      "$uid": {
        ".read": true,
        "$roomCode": {
          ".write": "auth !== null && (auth.uid === $uid || (!newData.exists() && (root.child('rooms/' + $roomCode + '/red/uid').val() === auth.uid || root.child('rooms/' + $roomCode + '/blue/uid').val() === auth.uid)))"
        }
      }
    },
    "usernames": {
      ".read": true,
      "$nameKey": {
        ".write": "auth !== null && (!data.exists() || data.val() === auth.uid) && $nameKey.matches(/^[a-z0-9_-]{1,20}$/)",
        ".validate": "newData.isString() && newData.val() === auth.uid"
      }
    }
  }
}
